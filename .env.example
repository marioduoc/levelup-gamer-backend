# copiar a .env y cambiar los valores antes de desplegar
MYSQL_ROOT_PASSWORD=cambiar-root
DB_USER=levelup
DB_PASSWORD=cambiar-clave
# minimo 32 caracteres, por ejemplo: openssl rand -base64 48
JWT_SECRET=cambiar-por-un-secreto-largo-de-al-menos-32-caracteres
# puerto publico del frontend
PUERTO_WEB=80
